# Copy to .env:  cp .env.example .env
# docker compose reads this file for both variable substitution and container env.

# ---- Compose profile: "lean" (8 GB RAM laptops) or "full" (separate workers + flower)
COMPOSE_PROFILES=lean

# ---- Security (CHANGE THESE; generate with: openssl rand -hex 32)
API_KEY=change-me-dev-api-key
WEBHOOK_SIGNING_SECRET=change-me-dev-webhook-secret

# ---- Host ports (change if something on your machine already uses them).
# These only affect your Mac; containers always talk to each other on the defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
API_PORT=8000

# ---- Postgres
POSTGRES_USER=sift
POSTGRES_PASSWORD=sift
POSTGRES_DB=sift
DATABASE_URL=postgresql+psycopg://sift:sift@postgres:5432/sift

# ---- Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# ---- Object storage (RustFS locally; unset S3_ENDPOINT_URL to use AWS S3)
S3_ENDPOINT_URL=http://objectstore:9000
S3_BUCKET=sift-documents
S3_ACCESS_KEY=sift-storage
S3_SECRET_KEY=change-me-storage-secret
S3_REGION=us-east-1

# ---- LLM (Ollama runs natively on the host; containers reach it here)
LLM_MODEL=ollama/qwen2.5:3b
LLM_API_BASE=http://host.docker.internal:11434

# ---- Limits / behaviour
MAX_UPLOAD_MB=10
MAX_PAGES=10
REVIEW_THRESHOLD=0.80
LOG_LEVEL=INFO
LOG_JSON=true
